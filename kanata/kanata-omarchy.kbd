;; Kanata config for Omarchy (Linux).
;; Global Emacs-style navigation (all apps):
;;   ctrl + p/n  -> up/down        ctrl + f/b -> right/left
;;   ctrl + a/e  -> home/end       ctrl + g/[ -> escape
;;   ctrl + ,/.  -> page up/down
;;   alt  + f/b  -> ctrl+right / ctrl+left (forward/backward word)
;; An override fires only while no other modifier (shift/super/alt) is held,
;; so Super combos (Agent, Audio, ChatGPT) pass through untouched.
;; Release the letter before the modifier, or an aborted combo types the letter.

(defcfg
  process-unmapped-keys yes)

(defsrc
  lctl   a    b    ,    .    e    f    g    n    p    [    lalt   rctl   ralt
)

(deflayer base
  lctl   a    b    ,    .    e    f    g    n    p    [    lalt   rctl   ralt
)

(defvar
  excl-ctrl (lsft rsft lmet rmet lalt ralt)
  excl-alt  (lsft rsft lmet rmet lctl rctl))

(defoverridesv2
  (lctl a) (home) $excl-ctrl ()
  (lctl b) (left) $excl-ctrl ()
  (lctl e) (end)  $excl-ctrl ()
  (lctl f) (right) $excl-ctrl ()
  (lctl n) (down) $excl-ctrl ()
  (lctl p) (up)   $excl-ctrl ()
  (lctl g) (esc)  $excl-ctrl ()
  (lctl ,) (pgup) $excl-ctrl ()
  (lctl .) (pgdn) $excl-ctrl ()
  (lctl [) (esc)  $excl-ctrl ()
  (rctl a) (home) $excl-ctrl ()
  (rctl b) (left) $excl-ctrl ()
  (rctl e) (end)  $excl-ctrl ()
  (rctl f) (right) $excl-ctrl ()
  (rctl n) (down) $excl-ctrl ()
  (rctl p) (up)   $excl-ctrl ()
  (rctl g) (esc)  $excl-ctrl ()
  (rctl ,) (pgup) $excl-ctrl ()
  (rctl .) (pgdn) $excl-ctrl ()
  (rctl [) (esc)  $excl-ctrl ()
  (lalt f) (lctl right) $excl-alt ()
  (lalt b) (lctl left)  $excl-alt ()
  (ralt f) (lctl right) $excl-alt ()
  (ralt b) (lctl left)  $excl-alt ())
